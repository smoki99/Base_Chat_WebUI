# ─────────────────────────────────────────────────────────────────────────────
# base-chat-webui – deploy environment (copy to deploy/.env, then adjust!)
# NO real secrets in this file – example values only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Main stack (deploy/docker-compose.yml) ───────────────────────────────────

# Host port for the web UI (only host-exposed port of the stack)
WEB_PORT=5173

# PostgreSQL (internal service – strong random password, change it!)
POSTGRES_PASSWORD=change-me-pg-7f3a9c21d4b8e056

# Admin dialog (DB-Admin) – strong shared secret, change it!
# (empty/removed = admin routes answer 403, feature disabled)
ADMIN_TOKEN=change-me-admin-xK9mP4vQ7wL2nR8t

# LLM – LM Studio on the 5090 machine (LAN-only, never internet)
CHAT_PROVIDER=openai
OPENAI_BASE_URL=http://192.168.178.117:1234/v1
# LM Studio ignores the key; any non-empty value works
OPENAI_API_KEY=lm-studio
# LM Studio serves the loaded model; set only if your server requires a name
OPENAI_MODEL=local-model

# Voice sidecar – voz on the 5090 machine (LAN-only, never internet)
VOICE_SERVICE_URL=http://192.168.178.117:8765

# CORS – the web UI is same-origin via nginx; set this only when accessing
# the API directly from a different origin
CORS_ORIGIN=http://localhost:5173

# ── Voice stack (deploy/voz/docker-compose.yml, on the 5090 machine) ─────────

# Host port for voz (LAN-only!)
VOICE_PORT=8765
# WHISPER_MODEL: optional override (default: CUDA → whisper-large-v3-turbo)