{
  "name": "base-chat-webui",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run audit && npm run audit:signatures && npm run verify:lockfile && npm run format:check && npm run typecheck && npm run lint && npm run knip && npm run depcheck && npm run pkg:validate && npm run qmd:setup -w api && npm test && npm run build && npm run size",
    "dev": "concurrently -n web,api -c cyan,yellow \"npm run dev -w web\" \"npm run dev -w api\"",
    "dev:lmstudio": "CHAT_PROVIDER=openai concurrently -n web,api -c cyan,yellow \"npm run dev -w web\" \"npm run dev -w api\"",
    "dev:clean": "pkill -f 'tsx watch src/index[.]ts' 2>/dev/null; fuser -k 4001/tcp 5173/tcp 2>/dev/null; sleep 1; echo '✔ Dev ports 4001/5173 freed (killed stale tsx/vite/api workers)'",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e -w web",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit": "npm audit --omit=dev --audit-level=critical",
    "audit:signatures": "npm audit signatures",
    "size": "npx size-limit",
    "depcheck": "depcruise --config .dependency-cruiser.cjs apps packages",
    "pkg:validate": "node -e \"['.', 'apps/api', 'apps/web', 'packages/shared'].forEach(p => { JSON.parse(require('fs').readFileSync(p + '/package.json')); console.log('✓ ' + p) })\"",
    "verify:lockfile": "node scripts/verify-lockfile.cjs",
    "prepare": "husky"
  },
  "size-limit": [
    {
      "name": "web",
      "path": "apps/web/dist/assets/*.js",
      "limit": "112 kB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10",
    "@size-limit/preset-app": "^14.2.0",
    "concurrently": "^10",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3",
    "size-limit": "^14.2.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8"
  }
}
