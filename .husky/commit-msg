#!/bin/sh
MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

if echo "$MSG" | head -1 | grep -qE '^Story-[0-9]{4}: '; then
  REST=$(echo "$MSG" | sed -E '1s/^Story-[0-9]{4}: //')
  TEMP_FILE=$(mktemp)
  echo "$REST" > "$TEMP_FILE"
  npx --no-install commitlint --edit "$TEMP_FILE"
  EXIT=$?
  rm -f "$TEMP_FILE"
  exit $EXIT
fi

npx --no-install commitlint --edit "$MSG_FILE"