# API
PORT=4001
# Bind address (default 127.0.0.1 = loopback-only; set 0.0.0.0 for LAN/Docker)
HOST=127.0.0.1
# CORS – comma-separated allowed origins for the API (prod), e.g. https://app.example.com
# Empty (dev) = allow all origins.
CORS_ORIGIN=
# Chat provider: "mock" (default) or "openai" (LM Studio / Ollama / any OpenAI-compatible)
CHAT_PROVIDER=mock
# OpenAI-compatible endpoint (used when CHAT_PROVIDER=openai)
# LM Studio defaults – works out of the box when LM Studio is running on localhost:1234
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
# LM Studio uses the currently loaded model regardless of this name.
# Set to your actual model name only if your server requires it (e.g. Ollama, vLLM).
OPENAI_MODEL=local-model
# Override chatbot rules file path (optional, defaults to apps/api/chatbot.rules.json)
# CHATBOT_RULES_FILE=/path/to/rules.json
# Override custom prompt file path (optional, default: apps/api/data/chatbot-custom-prompt.md).
# The file is gitignored – the stored prompt is instance data, never code (Story-0036).
# CHATBOT_CUSTOM_PROMPT_FILE=/path/to/custom-prompt.md

# MCP (Model Context Protocol) – optional
# Path to the MCP server config file (defaults to apps/api/mcp-config.json)
# MCP_CONFIG_FILE=/path/to/mcp-config.json
# Whitelist: comma-separated server names from the config file that may be
# spawned (empty = all configured servers, legacy behavior), e.g. sql,admin-db
MCP_ENABLED_SERVERS=
# Timeout per MCP JSON-RPC request in ms (default 30000)
MCP_REQUEST_TIMEOUT_MS=30000

# PostgreSQL (used by sql-mcp-server.mjs)
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# Admin – Postgres table manager (optional)
# Shared secret for the /api/admin/* endpoints (web "DB-Admin" dialog).
# If unset, all admin routes answer 403 (feature disabled).
# ADMIN_TOKEN=change-me
# Max rows per table export (CSV/XLSX) – default 10000.
# ADMIN_EXPORT_MAX_ROWS=10000
#

# Web (VITE_-Präfix = wird ins Bundle kopiert)
# Number of previous messages sent as conversation context (default: 20)
VITE_CONTEXT_MESSAGES=20

# Voice sidecar (optional – TTS + STT via apps/voz)
# Base URL of the voz sidecar (default http://127.0.0.1:8765)
VOICE_SERVICE_URL=http://127.0.0.1:8765
