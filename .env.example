# API
PORT=3001
# CORS – comma-separated allowed origins for the API (prod), e.g. https://app.example.com
# Empty (dev) = allow all origins.
CORS_ORIGIN=
# Chat provider: "mock" (default) or "openai" (LM Studio / Ollama / any OpenAI-compatible)
CHAT_PROVIDER=mock
# OpenAI-compatible endpoint (used when CHAT_PROVIDER=openai)
# LM Studio defaults – works out of the box when LM Studio is running on localhost:1234
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
# LM Studio uses the currently loaded model regardless of this name.
# Set to your actual model name only if your server requires it (e.g. Ollama, vLLM).
OPENAI_MODEL=local-model
# Override chatbot rules file path (optional, defaults to apps/api/chatbot.rules.json)
# CHATBOT_RULES_FILE=/path/to/rules.json

# MCP (Model Context Protocol) – optional
# Path to the MCP server config file (defaults to apps/api/mcp-config.json)
# MCP_CONFIG_FILE=/path/to/mcp-config.json
# Web (VITE_-Präfix = wird ins Bundle kopiert)
VITE_API_URL=http://localhost:3001